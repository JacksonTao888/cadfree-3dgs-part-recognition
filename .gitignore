C1[0-9][0-9]/

# ---------- Caches & scratch ----------
_featcache/
*.npz
__pycache__/
*.pyc
*.bak
*.bak_*
.ipynb_checkpoints/
.DS_Store
.env
logs/
*.log

# ---------- Force-allow: figures that ARE part of the release ----------
# assets/ holds the README and docs figures. It is never denied above as a
# directory, so these negations are reachable.
!assets/
!assets/*.png
!assets/*.jpg

# ---------- Force-allow: the curated release ----------
!.gitignore
!*.md
!*.py
!*.sh
!*.yml
!*.txt
!requirements.txt
!LICENSE
!data_prep/*.csv
!results/**/*.csv
!results/**/*.tsv
!results/**/*.json
!results/**/*.md
!results/confusion/*.npy
!docs/assets/*.jpg
!docs/assets/*.png
!docs/assets/*.mp4

# NOTE: git does not descend into an ignored directory, so a `!` rule can never
# rescue a file inside one. results/ and docs/assets/ are therefore NOT listed
# in any deny rule above — do not add one. Everything published is COPIED into
# the repo tree; nothing is published by negation out of a working directory.

# ---------- CAD reference models (keep) ----------
!cad/**/*.stl
!cad/*.jpg
!cad/**/*.SLDPRT
