# ---------- 3DGS / point clouds ----------
*.ply
**/point_cloud/
gs/
gs_obj/
gs_obj_hi/
output/
output_fine/
output_sugar/
cfg_args

# ---------- COLMAP ----------
*.db
*.db-journal
colmap/
colmap_sam/
sparse/
*.bin
project.ini

